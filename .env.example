# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=earthquake-events

# Dataset. Dosya adı bilerek Eartquakes olarak tutulur.
CSV_PATH=/app/data/raw/Eartquakes-1990-2023.csv

# Producer streaming simülasyonu
PRODUCER_SLEEP_SECONDS=0.05
PRODUCER_MAX_ROWS=1000
PRODUCER_LOOP=false
PRODUCER_KEY_FIELD=state
PRODUCER_LOG_EVERY=1000

# Spark
SPARK_WORKER_MEMORY=3G
SPARK_WORKER_CORES=2
SPARK_SQL_SHUFFLE_PARTITIONS=8
STREAM_TRIGGER_AVAILABLE_NOW=true
STREAM_PROCESSING_TIME=10 seconds

# MLflow + PostgreSQL + MinIO
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ML
TRAIN_TEST_SPLIT=0.8
RANDOM_SEED=42
